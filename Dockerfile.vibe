# Dockerfile.vibe — Mistral Vibe CLI container
# Installs the Vibe CLI and configures it to point at the shared Ollama backend.

FROM python:3.12-slim

# System deps for git operations and general CLI use
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Install the Vibe CLI (pip package) and requests for optional scripting
RUN pip install --no-cache-dir mistral-vibe requests

# Working directory; mounted at runtime from docker-compose
WORKDIR /workspace

# Write a minimal Vibe config that points at the Ollama provider.
# OLLAMA_BASE_URL and VIBE_MODEL are injected via docker-compose environment.
# This script runs at container start if no config file exists yet.
COPY scripts/vibe_bootstrap.sh /usr/local/bin/vibe_bootstrap.sh
RUN chmod +x /usr/local/bin/vibe_bootstrap.sh

ENTRYPOINT ["/usr/local/bin/vibe_bootstrap.sh"]
CMD ["tail", "-f", "/dev/null"]
