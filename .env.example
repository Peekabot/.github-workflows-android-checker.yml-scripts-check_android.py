# Copy this file to .env and fill in your values.
# docker-compose.yml reads these automatically.

# ── Model selection ────────────────────────────────────────────────────────────
# Tag must match what you pulled: docker exec -it ollama ollama pull <tag>
NULLCLAW_MODEL=devstral:24b-small-2505
VIBE_MODEL=devstral:24b-small-2505

# ── Notification webhooks (used by check_android.py + NullClaw) ───────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK=
